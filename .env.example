# Server-side only. No NEXT_PUBLIC_ variables for credentials.
AUTH_PROVIDER=central
AUTH_ORIGIN=http://127.0.0.1:3000
# ronaldo-service `npm run start:genbookno` (identity + genbookno on GENBOOKNO_PORT)
RONALDO_SERVICE_URL=http://127.0.0.1:3010
# Must match ronaldo-service IDENTITY_API_SECRET (random, at least 32 characters).
RONALDO_IDENTITY_SECRET=
# Absolute, private persistent directory owned by the app. Required in production.
AUTH_SESSION_DIRECTORY=
# Book data comes only from ronaldo-service /api/v1/genbookno (genbookno_db); genbook has no DB connection.
# Must match ronaldo-service GENBOOKNO_API_SECRET (random, at least 32 characters). Server-side only.
GENBOOKNO_API_SECRET=
