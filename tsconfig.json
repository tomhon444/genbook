{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".local/next-t05/types/**/*.ts",
    ".local/next-t05/dev/types/**/*.ts",
    ".local/next-t04/types/**/*.ts",
    ".local/next-t04/dev/types/**/*.ts",
    ".local/next-t07/types/**/*.ts",
    ".local/next-t07/dev/types/**/*.ts",
    ".local/next-t10/types/**/*.ts",
    ".local/next-t10/dev/types/**/*.ts",
    ".local/next-t08/types/**/*.ts",
    ".local/next-t08/dev/types/**/*.ts",
    ".local/next-t09/types/**/*.ts",
    ".local/next-t09/dev/types/**/*.ts",
    ".local/next-t12-details/types/**/*.ts",
    ".local/next-t12-details/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
