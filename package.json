{
  "name": "genbook-no",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:local": "node tools/local-auth/run.mjs",
    "dev:ronaldo": "node tools/ronaldo-auth/run.mjs",
    "dev:ronaldo:demo": "node tools/ronaldo-auth/run.mjs --demo",
    "dev:references": "node tools/local-auth/apply-reference-preview.mjs",
    "test:references": "node --test --test-concurrency=1 tools/issuance/legacy-catalog.test.mjs tools/local-auth/reference-data.test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:auth": "node --test tools/local-auth/provider.test.mjs",
    "test:auth:ronaldo": "node --test tools/ronaldo-auth/*.test.mjs",
    "test:issuance": "node --test tools/issuance/rules.test.mjs tools/issuance/backdated.test.mjs",
    "test:search": "node --test tools/issuance/search.test.mjs",
    "test:migration": "node --test --test-concurrency=1 tools/migration/migration.test.mjs tools/migration/investigation.test.mjs tools/migration/duplicates.test.mjs tools/migration/preservation.test.mjs tools/migration/mapping.test.mjs tools/migration/http-rehearsal-input.test.mjs",
    "test:migration:http:process": "node --test --test-concurrency=1 tools/migration/http-rehearsal-process.test.mjs",
    "test:migration:files": "node --test --test-concurrency=1 tools/migration/source-snapshot.test.mjs tools/migration/export-live.test.mjs tools/migration/attachments.test.mjs tools/migration/attachment-blob-import.test.mjs tools/migration/local-target.test.mjs",
    "migration:export": "node tools/migration/export-live.mjs",
    "migration:native": "node tools/migration/import-native.mjs",
    "test:migration:native": "node --test tools/migration/native-dump.test.mjs",
    "migration:files": "node tools/migration/attachments.mjs",
    "migration:local:files": "node tools/migration/import-local-files.mjs",
    "migration:rehearse": "node tools/migration/rehearse.mjs",
    "migration:preserve": "node tools/migration/preserve-rehearsal.mjs",
    "migration:check": "node tools/migration/check-mapping.mjs",
    "migration:promote:rehearse": "node tools/migration/rehearse-promotion.mjs",
    "migration:http:rehearse": "node tools/migration/rehearse-http.mjs",
    "migration:review:ac2": "node tools/migration/prepare-ac2-review.mjs",
    "test:migration:ac2": "node --test tools/migration/ac2-review.test.mjs",
    "migration:review:names": "node tools/migration/reference-names.mjs",
    "test:migration:names": "node --test tools/migration/reference-names.test.mjs",
    "migration:review:decisions": "node tools/migration/prepare-decision-review.mjs",
    "test:migration:decisions": "node --test tools/migration/decision-review.test.mjs",
    "migration:review:investigate": "node tools/migration/investigate-reference-exceptions.mjs",
    "test:migration:investigate": "node --test tools/migration/reference-investigation.test.mjs",
    "migration:local": "node tools/migration/local.mjs",
    "migration:workbench": "node tools/migration/prepare-workbench.mjs",
    "test:migration:workbench": "node --test tools/migration/workbench.test.mjs",
    "test:migration:local": "node --test --test-concurrency=1 tools/migration/persistent-database.test.mjs tools/migration/local-preservation.test.mjs",
    "test:e2e": "playwright test",
    "test:production-auth": "node tools/local-auth/check-production.mjs"
  },
  "dependencies": {
    "@coreui/coreui": "5.9.1",
    "@coreui/react": "5.13.1",
    "ag-grid-community": "36.3.0",
    "ag-grid-react": "36.3.0",
    "mysql2": "3.24.6",
    "next": "16.4.5",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
